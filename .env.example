# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# Auth Secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your_secret_key_here

# Dashboard snapshot encryption keyring. Generate each value independently with
# `openssl rand -base64 32`; keep prior versions in the JSON object until old
# snapshots are next written or deliberately migrated. This is independent of AUTH_SECRET.
DASHBOARD_STATE_ENCRYPTION_KEY_VERSION=v1
DASHBOARD_STATE_ENCRYPTION_KEYS={"v1":"your_independent_32_byte_encryption_secret"}

# Optional fallback for enc:v1 snapshots if AUTH_SECRET is rotated before every
# record has migrated. Keep the old AUTH_SECRET here until migration is complete.
# DASHBOARD_STATE_LEGACY_AUTH_SECRETS=["previous_auth_secret"]

# Base URL (for local dev)
AUTH_TRUST_HOST=true

# Local dev preview (optional)
# `npm run dev` on localhost skips GitHub sign-in and fills the dashboard with
# sample data, so you can look at the UI without connecting real accounts. Set
# this to `false` to exercise the real sign-in flow locally instead. It has no
# effect on a build — the preview is compiled out. Requests from a LAN address
# or through `npm run dev:tunnel` always use real auth.
# DEV_AUTH_BYPASS=false

# Google Maps API Key (for Traffic Widget)
# Get your API key at: https://console.cloud.google.com/apis/credentials
# Enable the Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Analytics OAuth (for the GA4 widget)
# Create an OAuth client at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <origin>/api/analytics/callback
GA_OAUTH_CLIENT_ID=your_ga_oauth_client_id
GA_OAUTH_CLIENT_SECRET=your_ga_oauth_client_secret

# CoinGecko Demo API key (optional — the Crypto widget works without one,
# just on the lower anonymous rate limit). https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_demo_key
